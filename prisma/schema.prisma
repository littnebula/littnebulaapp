// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum VisibilityType {
  PUBLIC
  RESTRICTED
  PRIVATE
}

model User {
  id            Int           @id @default(autoincrement())
  displayIconIndex     Int   @default(0)
  displayColorIndex   Int   @default(0)
  email         String        @unique
  password      String
  role          Role          @default(USER)
  ownedWC       WordCloud[]   @relation("OwnedWC")
  editAccessWC  WordCloud[]   @relation("EditAccessWC")
  bookmarkedWC  BookmarkedWC[] 
	recentlyWC    ViewedWC[]
  collections   Collection[]
}

model Word {
  id          Int       @id @default(autoincrement())
	text        String
	value       Int
	annotation  String    @default("")
  wordcloud   WordCloud @relation(fields: [wordcloudId], references: [id], onDelete: Cascade)
  wordcloudId Int
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

model WordCloud {
  id            Int      @id @default(autoincrement())
	owner         String
  creatorId     Int
  creator       User     @relation("OwnedWC", fields: [creatorId], references: [id])

  language      String
  wordData      Word[]
  sourceTotal   Int     @default(1)
  displayCount  Int     @default(10)
  createdAt     DateTime @default(now()) 
  bibliography  String
  title         String
  description   String 
  tags          String[]
  visibility    VisibilityType  @default(PUBLIC)
  views         Int      @default(0)
  bookmarks     Int      @default(0)

  displayColorIndex     Int     @default(0)
  displayIconIndex      Int     @default(0)

  editors       String[]  @default([])
  editingUsers  User[]          @relation("EditAccessWC")

  comments      Comment[]

  viewedWC      ViewedWC[]
  bookmarkedWC  BookmarkedWC[]

  datasetLinks  DatasetWordClouds[]
}

model ViewedWC {
  userId        Int
  wordcloudId   Int
  viewedAt DateTime @default(now()) @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordcloud WordCloud   @relation(fields: [wordcloudId], references: [id], onDelete: Cascade)

  @@id([userId, wordcloudId])
}

model BookmarkedWC {
  userId    Int
  wordcloudId    Int
  createdAt DateTime @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordcloud WordCloud   @relation(fields: [wordcloudId], references: [id], onDelete: Cascade)

  @@id([userId, wordcloudId])
}

model Collection {
  id        Int            @id @default(autoincrement())
	owner     String
  userId    Int
  user      User           @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())

  dataset   DatasetWordClouds[]
  
  title         String
  description   String 
  views         Int      @default(0)
  visibility    VisibilityType  @default(PUBLIC)

  leftColorIndex Int    @default(0)
  rightColorIndex Int    @default(1)

  comments      Comment[]
}

model DatasetWordClouds {
  collectionId Int
  wordcloudId  Int
  position     Int      @default(0)
  addedAt      DateTime @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  wordcloud    WordCloud  @relation(fields: [wordcloudId], references: [id], onDelete: Cascade)

  @@id([collectionId, wordcloudId])
}

model Comment {
  id          Int       @id @default(autoincrement())
	owner       String
	comment     String
	timestamp   DateTime  @default(now())
  wordcloud   WordCloud @relation(fields: [wordcloudId], references: [id], onDelete: Cascade)
  wordcloudId Int
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId  Int 
}

model Report {
  id          Int       @id @default(autoincrement())
  wordcloudId Int
  userId      Int
  reporterId  Int
  context     String
  reason      String
  resolution  String
}
